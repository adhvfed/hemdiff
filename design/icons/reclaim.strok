# @meaning Permanently delete build artifacts
# @tags delete, reclaim, cleanup
documentsize 24x24
defaults
  fill none
  stroke currentColor
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round
shape body template=path
  addpoint tl at=7,10
  addpoint tr at=17,10
  addpoint br at=16,20
  addpoint bl at=8,20
  close
shape line template=line
place body shape=body at=0,0
place lid shape=line from=5,7 to=19,7
place handle shape=line from=9,4 to=15,4
